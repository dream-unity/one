{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Private preview invite exchange v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": 1
    },
    "inviteCode": {
      "type": "string",
      "minLength": 22,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_-]+$"
    }
  },
  "required": [
    "version",
    "inviteCode"
  ]
}
